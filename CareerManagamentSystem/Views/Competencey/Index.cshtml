
@{
    ViewBag.Title = "Index";
}
<html lang="en">
<head>
    <!-- Fontfaces CSS-->
    <link href="/cooladmin/css/font-face.css" rel="stylesheet" media="all">
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <link href="/cooladmin/vendor/fontawesome-7.2.0/css/all.min.css" rel="stylesheet" media="all"><!-- Bootstrap CSS-->
    <link href="/cooladmin/vendor/bootstrap-5.3.8.min.css" rel="stylesheet" media="all">

    <!-- Vendor CSS-->
    <link href="/cooladmin/vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all"><!-- Main CSS-->
    <link href="/cooladmin/css/theme.css" rel="stylesheet" media="all">
    <link href="/cooladmin/css/theme-2026.css" rel="stylesheet" media="all">

</head>

<body>
    <div class="row">
        <div class="col-lg-6">
            <section class="m-card">
                <header class="m-card__header">
                    <div>
                        <h2 class="m-card__title">Pasta Grafik</h2>
                        <p class="m-card__subtitle">Mevcut teknik yetkinlikler. </p>
                    </div>
                </header>
                <div style="height: 280px; position: relative;"><canvas id="polarChart"></canvas></div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="m-card">
                <header class="m-card__header">
                    <div>
                        <h2 class="m-card__title">Radar Grafik</h2>
                        <p class="m-card__subtitle">Mevcut kişisel yetkinlikler.</p>
                    </div>
                </header>
                <div style="height: 280px; position: relative;"><canvas id="radarChart"></canvas></div>
            </section>
        </div>
    </div>

    <!-- Jquery JS-->
    <script src="/cooladmin/js/vanilla-utils.js"></script>
    <!-- Bootstrap JS-->
    <script src="/cooladmin/vendor/bootstrap-5.3.8.bundle.min.js"></script>
    <!-- Vendor JS       -->
    <script src="/cooladmin/vendor/chartjs/chart.umd.js-4.5.1.min.js"></script>

    <!-- Main JS-->
    <script src="/cooladmin/js/bootstrap5-init.js"></script>
    <script src="/cooladmin/js/main-vanilla.js"></script>
    <script src="/cooladmin/js/modern-plugins.js"></script>
    <script>
        (function () {
            const PALETTE = ['#4272d7', '#11998e', '#f97316', '#ec4899', '#8b5cf6'];
            const SOFT_PALETTE = ['rgba(66, 114, 215, 0.85)', 'rgba(17, 153, 142, 0.85)', 'rgba(249, 115, 22, 0.85)', 'rgba(236, 72, 153, 0.85)', 'rgba(139, 92, 246, 0.85)'];
            const tip = (typeof modernTooltip !== 'undefined') ? modernTooltip : {
                backgroundColor: '#0f172a', titleColor: '#f1f5f9', bodyColor: '#e2e8f0',
                borderWidth: 0, cornerRadius: 6, padding: 10,
            };
            const fontFam = (typeof INTER !== 'undefined') ? INTER : '"Inter", system-ui, sans-serif';
            const tickStyle = { font: { family: fontFam, size: 11 }, color: '#94a3b8' };
            const gridStyle = { color: '#eef0f3', drawBorder: false };
            const legendStyle = {
                display: true, position: 'top', align: 'end',
                labels: { usePointStyle: true, pointStyle: 'circle', boxWidth: 6, boxHeight: 6, padding: 14, font: { family: fontFam, size: 12 }, color: '#475569' }
            };
            function gradient(ctx, h, c1, c2) {
                const c = ctx.getContext('2d');
                const g = c.createLinearGradient(0, 0, 0, h);
                g.addColorStop(0, c1); g.addColorStop(1, c2);
                return g;
            }

            // 8. Polar
            const polarCtx = document.getElementById('polarChart');
            if (polarCtx) {
                new Chart(polarCtx, {
                    type: 'polarArea',
                    data: { labels: ['C#', 'SQL ', 'Python', 'JavaScript', 'Java'], datasets: [{ data: [30, 45, 25, 35, 40], backgroundColor: SOFT_PALETTE, borderColor: PALETTE, borderWidth: 1.5 }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: true, position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 12, font: { family: fontFam, size: 12 }, color: '#475569' } }, tooltip: tip }, scales: { r: { beginAtZero: true, grid: { color: '#eef0f3' }, angleLines: { color: '#eef0f3' }, ticks: { display: false } } } }
                });
            }

            // 4. Radar
            const radarCtx = document.getElementById('radarChart');
            if (radarCtx) {
                new Chart(radarCtx, {
                    type: 'radar',
                    data: {
                        labels: ['Performance', 'Scalability', 'Security', 'Usability', 'Reliability', 'Maintainability'],
                        datasets: [
                            
                            { label: 'Mevcut', data: [90, 85, 95, 90, 95, 85], backgroundColor: 'rgba(17, 153, 142, 0.15)', borderColor: PALETTE[1], borderWidth: 2, pointBackgroundColor: PALETTE[1], pointBorderColor: '#fff', pointBorderWidth: 1.5 }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: legendStyle, tooltip: tip },
                        scales: { r: { beginAtZero: true, max: 100, grid: { color: '#eef0f3' }, angleLines: { color: '#eef0f3' }, pointLabels: { font: { family: fontFam, size: 11 }, color: '#475569' }, ticks: { display: false } } }
                    }
                });
            }
        })();
    </script>
    </body>
</html>