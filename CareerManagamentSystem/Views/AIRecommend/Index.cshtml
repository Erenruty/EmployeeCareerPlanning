
@{
    ViewBag.Title = "Index";
}



<div class="row">
    <!-- AI Cevap-->
    <div class="m-card shadow mb-4  col-lg-6">
        <div class="card-header bg-primary text-white rounded-2">
            <i class="bi bi-stars"></i>
            AI Kariyer Analizi
        </div>

        <div class="card-body">

            AI tarafından oluşturulan açıklama...

        </div>
    </div>
    <!-- Onerilen Egitimler -->
    <div class="m-card shadow mb-4  col-lg-5" style="margin-left: 20px; ">
        <div class="card-header bg-success text-white rounded-2">
            <i class="bi bi-clipboard-check"></i>
            Onerilen Egitimler
        </div>

        <div class="card-body">

            <ul>
                <li>Cloud Teknolojileri Eğitimi</li>
                <li>İngilizce Geliştirme Kursu</li>
                <li>Yapay Zeka ve Makine Öğrenimi Eğitimi</li>

            </ul>

        </div>
    </div>
</div>

<!-- Egitim sirasi-->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="bi bi-stars text-warning"></i>
            AI Önerilen Eğitim Sırası
        </h5>
    </div>

    <div class="card-body">

        <div class="d-flex align-items-center overflow-auto pb-2">

            <!-- Eğitim 1 -->
            <div class="card text-center border-primary" style="min-width:220px;">
                <div class="card-body">
                    <span class="badge bg-primary rounded-pill mb-2">1</span>

                    <h5>C# Temelleri</h5>

                    <p class="text-muted mb-2">
                        Programlama temellerini öğren.
                    </p>

                    <span class="badge bg-success">
                        <i class="bi bi-clock"></i>
                        2 Hafta
                    </span>
                </div>
            </div>

            <i class="bi bi-arrow-right fs-2 mx-3 text-secondary"></i>

            <!-- Eğitim 2 -->
            <div class="card text-center" style="min-width:220px;">
                <div class="card-body">
                    <span class="badge bg-primary rounded-pill mb-2">2</span>

                    <h5>OOP</h5>

                    <p class="text-muted mb-2">
                        Class, Interface ve Inheritance.
                    </p>

                    <span class="badge bg-info">
                        <i class="bi bi-clock"></i>
                        1 Hafta
                    </span>
                </div>
            </div>

            <i class="bi bi-arrow-right fs-2 mx-3 text-secondary"></i>

            <!-- Eğitim 3 -->
            <div class="card text-center border-success shadow-sm" style="min-width:220px;">
                <div class="card-body">

                    <span class="badge bg-success rounded-pill mb-2">
                        Şu Anda
                    </span>

                    <h5>ASP.NET Core</h5>

                    <p class="text-muted mb-2">
                        Web uygulamaları geliştirmeye başla.
                    </p>

                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-clock"></i>
                        3 Hafta
                    </span>

                </div>
            </div>

            <i class="bi bi-arrow-right fs-2 mx-3 text-secondary"></i>

            <!-- Eğitim 4 -->
            <div class="card text-center" style="min-width:220px;">
                <div class="card-body">
                    <span class="badge bg-secondary rounded-pill mb-2">4</span>

                    <h5>SQL Server</h5>

                    <p class="text-muted mb-2">
                        Veritabanı yönetimini öğren.
                    </p>

                    <span class="badge bg-danger">
                        Sonraki
                    </span>
                </div>
            </div>

        </div>

    </div>
</div>
<!-- ai-->
<style>
    .career-line {
        width: 3px;
        height: 45px;
        background: #dee2e6;
        margin: 8px auto;
    }

    .career-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
        margin: auto;
    }
</style>

