@using CareerManagamentSystem.Models;
@{
    ViewBag.Title = "Home Page";
}

<h2> Tekrardan Hoşgeldin</h2>
<div class="row " style="margin-top: 10px;">
    <!-- Progress Bar-->
    <div class="col-lg-6">
        <h5 class="section-eyebrow" >İlerleme</h5>
        <div><section class="m-card ">
                <header class="m-card__header"><div><h2 class="m-card__title">Kariyer İlerlemesi</h2><p class="m-card__subtitle"></p></div></header>
   
                <span class="au-progress__title">Senior Software Developer &middot; %81</span>
                     <div class="progress" role="progressbar" aria-label="Animated striped example" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" style="height:30px; border-radius: 15px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 75%; background-color: rgb(17, 153, 142); "> %75 </div>
                      </div>
            </section>
        </div>
    </div>
    <!-- Profile Card -->
    <div class="col-lg-6">
        <h5 class="section-eyebrow">PROFİL</h5>
        <section class="m-card profile-card" style="background: linear-gradient(135deg, #4272d7 0%, #3155b3 100%); color: #fff; border-color: transparent;">
            <div></div>
            <h2 class="profile-card__name" style="color: #fff;">Eren Gunes</h2>
            <p class="profile-card__role" style="color: rgba(255,255,255,0.85);">Junior Software Developer &middot; Kocaeli</p>
            <hr class="profile-card__divider" style="border-color: rgba(255,255,255,0.20); margin-top: 1rem;">
            <p style="font-size: 13px; color: rgba(255,255,255,0.92); margin: 0; line-height: 1.5;">&ldquo;Design isn&rsquo;t how it looks &mdash; it&rsquo;s how it works. And then how it looks.&rdquo;</p>
            <div style="margin-top: 18px;">
                <button type="button" class="m-btn" style="background: #fff; color: var(--m-accent); border: 0;">Profili Görüntüle</button>
            </div>
        </section>
    </div>
</div>
<!-- Top-3 Competencey-->
<div class="row" style=" margin-top: 20px;">
    <div class="col-lg-6">
        <h5 class="section-eyebrow"> Devam Eden Eğitimler</h5>
        <section class="m-card">
            <header class="m-card__header"><div><h2 class="m-card__title">Eğitimler</h2><p class="m-card__subtitle"></p></div></header>
            <ul class="rank-list">
                <li>
                    <span class="rank-list__rank">1</span>
                    <span class="rank-list__title">C#</span>
                    <span class="rank-list__value">%90</span>
                    <span class="rank-list__bar" style="--rank-pct: 90%;"></span>
                </li>
                <li>
                    <span class="rank-list__rank">2</span>
                    <span class="rank-list__title">SQL</span>
                    <span class="rank-list__value">%79</span>
                    <span class="rank-list__bar" style="--rank-pct: 79%;"></span>
                </li>
                <li>
                    <span class="rank-list__rank">3</span>
                    <span class="rank-list__title">MVC</span>
                    <span class="rank-list__value">%57</span>
                    <span class="rank-list__bar" style="--rank-pct: 57%;"></span>
                </li>

            </ul>
        </section>
    </div>
    <div class="col-lg-6">
        <h5 class="section-eyebrow" >Yetkinlikler</h5>
        <section class="m-card">
            <header class="m-card__header"><div><h2 class="m-card__title">En iyi 3 yetkinlik </h2><p class="m-card__subtitle"></p></div></header>
            <div style="display:flex;gap:32px;flex-wrap:wrap;align-items:center;">
                <div class="circular-progress" style="--pct:75; --color:var(--m-c1);">
                    <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9155" class="bg" /><circle cx="18" cy="18" r="15.9155" class="fg" /></svg>
                    <div class="circular-progress__label"><strong>75%</strong><span>C#</span></div>
                </div>
                <div class="circular-progress" style="--pct:42; --color:var(--m-c2);">
                    <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9155" class="bg" /><circle cx="18" cy="18" r="15.9155" class="fg" /></svg>
                    <div class="circular-progress__label"><strong>42%</strong><span>SQL</span></div>
                </div>
                <div class="circular-progress" style="--pct:88; --color:var(--m-c3);">
                    <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9155" class="bg" /><circle cx="18" cy="18" r="15.9155" class="fg" /></svg>
                    <div class="circular-progress__label"><strong>88%</strong><span>MVC</span></div>
                </div>
                
            </div>
        </section>



    </div>
</div>