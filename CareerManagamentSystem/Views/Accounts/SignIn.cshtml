    <title>Create account | CoolAdmin Bootstrap 5 Admin Dashboard</title>
    <meta name="robots" content="noindex,nofollow">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Create account | CoolAdmin Bootstrap 5 Admin Dashboard">
    <meta property="og:description" content="Create a new CoolAdmin account.">
    <meta property="og:image" content="screenshots/cooladmin-bootstrap-dashboard-2.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Create account | CoolAdmin Bootstrap 5 Admin Dashboard">
