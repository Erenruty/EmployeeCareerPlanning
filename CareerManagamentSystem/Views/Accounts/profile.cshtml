
@using CareerManagamentSystem.Models
@{
    ViewBag.Title = "profile";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="generator" content="CoolAdmin 3.2.0">
    <meta name="description" content="Profile, security, notifications, billing, and API keys settings.">
    <title>Account & settings | CoolAdmin Bootstrap 5 Admin Dashboard</title>
    <meta property="og:type" content="website">
    <meta property="og:title" content="Account & settings | CoolAdmin Bootstrap 5 Admin Dashboard">
    <meta property="og:description" content="Profile, security, notifications, billing, and API keys settings.">
    <meta property="og:image" content="screenshots/cooladmin-bootstrap-dashboard-2.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Account & settings | CoolAdmin Bootstrap 5 Admin Dashboard">
    <meta name="twitter:description" content="Profile, security, notifications, billing, and API keys settings.">
    <meta name="theme-color" content="#4272d7">

    <link href="/cooladmin/css/font-face.css" rel="stylesheet" media="all">
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <link href="/cooladmin/vendor/fontawesome-7.2.0/css/all.min.css" rel="stylesheet" media="all">

    <link href="/cooladmin/vendor/bootstrap-5.3.8.min.css" rel="stylesheet" media="all">
    <link href="/cooladmin/vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all">

    <link href="/cooladmin/css/theme.css" rel="stylesheet" media="all">
    <link href="/cooladmin/css/theme-2026.css" rel="stylesheet" media="all">
</head>

<body class="theme-2026">
    
                        <div class="page-header">
                            <div>
                                <h1>HESABIM</h1>
                                <p class="subtitle">Hesabını Yönet.</p>

                            </div>
                            <div class="page-header__actions">
                                <button type="button" class="m-btn m-btn--ghost" onclick="window.toast && window.toast.info('Discarded changes')">Cancel</button>
                                <button type="button" class="m-btn m-btn--primary" onclick="window.toast && window.toast.success('Settings saved')">
                                    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save changes
                                </button>
                            </div>
                        </div>

                        

                        <div class="tab-content">
                            <!-- ACCOUNT TAB -->
                            <div class="tab-pane fade show active" id="tab-account" role="tabpanel">
                                <div class="row row-tight">
                                    <div class="col-lg-8">
                                        <section class="m-card">
                                            <header class="m-card__header">
                                                <div>
                                                    <h2 class="m-card__title">Kişisel Bilgiler</h2>
                                                    <p class="m-card__subtitle"></p>
                                                </div>
                                            </header>
                                            <form onsubmit="event.preventDefault(); window.toast && window.toast.success('Profile updated');">
                                                <div class="row">
                                                    <div class="col-md-6 form-group">
                                                        <label for="first-name">Adı</label>
                                                        <input id="first-name" type="text" readonly class="form-control" value="@*@ViewBag.Employee.Ad*@" autocomplete="given-name">
                                                    </div>
                                                    <div class="col-md-6 form-group">
                                                        <label for="last-name">Soyadı</label>
                                                        <input id="last-name" type="text" readonly class="form-control" value="@*@ViewBag.Employee.Soyad*@" autocomplete="family-name">
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label for="email">E-posta</label>
                                                    <input id="email" type="email" class="form-control" value="@*@ViewBag.User.Email*@" autocomplete="email">
                                                </div>
                                                <div class="form-group">
                                                    <label for="role">Meslek</label>
                                                    <input id="role" type="text" class="form-control" value="@*@ViewBag.Employee.Positions.PositionName*@">
                                                </div>
                                                <div class="form-group">
                                                    <label for="hdate">İşe Giriş Tarihi</label>
                                                   <input id="hdate" type="text" readonly class="form-control" value="@*@ViewBag.Employee.HireDate*@" autocomplete="hday">
                                                </div>
                                                
                                            </form>
                                        </section>
                                    </div>
                                </div>
                            </div>
                        </div>

                       


    <!-- Scripts -->
    <script src="/cooladmin/js/vanilla-utils.js"></script>
    <script src="/cooladmin/vendor/bootstrap-5.3.8.bundle.min.js"></script>
    <script src="/cooladmin/vendor/chartjs/chart.umd.js-4.5.1.min.js"></script>
    <script src="/cooladmin/js/bootstrap5-init.js"></script>
    <script src="/cooladmin/js/main-vanilla.js"></script>
    <script src="/cooladmin/js/modern-plugins.js"></script>

</body>
</html>


