
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="generator" content="CoolAdmin 3.2.0" />
    <meta name="description" content="Sign in to the CoolAdmin dashboard." />
    <title>Sign in | CoolAdmin Bootstrap 5 Admin Dashboard</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Sign in | CoolAdmin Bootstrap 5 Admin Dashboard" />
    <meta property="og:description" content="Sign in to the CoolAdmin dashboard." />
    <meta property="og:image" content="screenshots/cooladmin-bootstrap-dashboard-2.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sign in | CoolAdmin Bootstrap 5 Admin Dashboard" />
    <meta name="twitter:description" content="Sign in to the CoolAdmin dashboard." />
    <meta name="theme-color" content="#4272d7" />
    <link href="css/font-face.css" rel="stylesheet" media="all" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link href="/cooladmin/vendor/fontawesome-7.2.0/css/all.min.css" rel="stylesheet" media="all" />
    <link href="/cooladmin/vendor/bootstrap-5.3.8.min.css" rel="stylesheet" media="all" />
    <link href="/cooladmin/vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all" />
    <link href="/cooladmin/css/theme.css" rel="stylesheet" media="all" />
    <link href="/cooladmin/css/theme-2026.css" rel="stylesheet" media="all" />
</head>
<body class="theme-2026 auth-page">
    <a class="visually-hidden-focusable skip-link" href="#auth-form">Skip to sign-in form</a>
    <main class="login-wrap" id="auth-form">
        <div class="login-content">
            <a href="index.html" class="auth-brand" aria-label="CoolAdmin home">
                <span class="logo-mark" aria-hidden="true">C</span>
                <span class="logo-text">CoolAdmin</span>
            </a>
            <h1 class="auth-title">Hoş Geldiniz</h1>
            <p class="auth-subtitle">Devam etmek için giriş yapın</p>
            <!-- Login Formu -->> 
            <form class="login-form" action="/Accounts/Login" method="post" >
                <div class="form-group">
                    <label for="email">Email Adresi</label>
                    <input id="email" class="au-input" type="email" name="email"
                           placeholder="you@example.com" autocomplete="email" required>
                </div>
                <div class="form-group">
                    <label for="password">Şifre</label>
                    <input id="password" class="au-input" type="password" name="password"
                           placeholder="••••••••" autocomplete="current-password" required>
                </div>
                <div class="login-checkbox">
                    <label>
                        <input type="checkbox" name="">
                        Beni hatırla
                    </label>
                    <a href="forget-pass.html">Şifremi unuttum?</a>
                </div>
                <button class="au-btn au-btn--green" type="submit">Giriş Yap</button>

                
            </form>
            <div>
                <p>@ViewBag.ErrorMessage</p>
            </div>
            <div class="register-link">
                <p>Hesabın yok mu? <a href="/Accounts/SignIn">Bir tane oluştur</a></p>
            </div>

        </div>  
    </main>
    <script src="/cooladmin/js/vanilla-utils.js"></script>
    <script src="/cooladmin/vendor/bootstrap-5.3.8.bundle.min.js"></script>
    <script src="/cooladmin/js/bootstrap5-init.js"></script>
    <script src="/cooladmin/js/main-vanilla.js"></script>
    <script src="/cooladmin/js/modern-plugins.js"></script>
</body>
</html>