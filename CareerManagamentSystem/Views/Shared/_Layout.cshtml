                                                <div class="image"><a href="#"><img src="images/icon/avatar-01.jpg" alt=""></a></div>
                                                <div class="content">
                                                    <h5 class="name"><a href="#">john doe</a></h5>
                                                    <span class="email">johndoe@example.com</span>
                                                </div>
                                            </div>
