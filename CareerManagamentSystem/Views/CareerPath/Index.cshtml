
@{
    ViewBag.Title = "Index";
}


<style>
    .hero {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        border-radius: 20px;
    }

    .timeline {
        position: relative;
        margin-top: 30px;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 4px;
            background: #dee2e6;
            transform: translateX(-50%);
        }

    .timeline-item {
        position: relative;
        margin-bottom: 50px;
    }

    .timeline-dot {
        position: absolute;
        left: 50%;
        top: 35px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #0d6efd;
        border: 4px solid white;
        transform: translateX(-50%);
        z-index: 10;
    }

    .timeline-card {
        width: 45%;
        transition: .3s;
    }

    .timeline-item:nth-child(odd) .timeline-card {
        margin-right: auto;
    }

    .timeline-item:nth-child(even) .timeline-card {
        margin-left: auto;
    }

    .timeline-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 1rem 2rem rgba(0,0,0,.15);
    }

    .nav-pills .nav-link {
        border-radius: 12px;
        font-weight: 600;
        padding: 12px 20px;
    }

        .nav-pills .nav-link.active {
            background: linear-gradient(90deg,#4f46e5,#2563eb);
        }
</style>

<div class="container">

    <!-- HERO -->

    <div class="card hero border-0 shadow-lg text-white mb-5">

        <div class="m-card text-center ">
             <button class="btn btn-light btn-primary btn-lg px-5 mt-3">
                <i class="bi bi-rocket-takeoff-fill me-2"></i>
                Kariyer Yolunu Oluştur
            </button>

            <p class="text-black-50 my-1">
                Mevcut yetkinliklerini analiz eder, sana en uygun kariyer yolunu ve gelişim planını oluşturur.
            </p>

        </div>

    </div>


    <!-- ROADMAP SEKMELERİ -->

    <div class="overflow-auto mb-5">

        <ul class="nav nav-pills flex-nowrap">

            <li class="nav-item me-2">
                <button class="nav-link active"
                        data-bs-toggle="pill"
                        data-bs-target="#backend">

                    🚀 Backend
                    <span class="badge bg-light text-dark ms-2">
                        %92
                    </span>

                </button>
            </li>

            <li class="nav-item me-2">
                <button class="nav-link"
                        data-bs-toggle="pill"
                        data-bs-target="#data">

                    📊 Data Engineer
                    <span class="badge bg-light text-dark ms-2">
                        %88
                    </span>

                </button>
            </li>

            <li class="nav-item">

                <button class="nav-link"
                        data-bs-toggle="pill"
                        data-bs-target="#cloud">

                    ☁️ Cloud Engineer

                    <span class="badge bg-light text-dark ms-2">
                        %84
                    </span>

                </button>

            </li>

        </ul>

    </div>


    <div class="tab-content">

        <!-- BACKEND ROADMAP -->

        <div class="tab-pane fade show active" id="backend">

            <div class="timeline">

                <!-- Junior -->

                <div class="timeline-item">

                    <div class="timeline-dot bg-success"></div>

                    <div class="card timeline-card shadow">

                        <div class="card-header bg-success text-white">
                            Junior Backend Developer
                        </div>

                        <div class="card-body">

                            <span class="badge bg-success mb-3">
                                Mevcut Pozisyon
                            </span>

                            <h6>Teknik Yetkinlikler</h6>

                            <span class="badge bg-primary">C#</span>
                            <span class="badge bg-primary">SQL</span>
                            <span class="badge bg-primary">Git</span>
                            <span class="badge bg-primary">OOP</span>

                            <hr>

                            <h6>Soft Skills</h6>

                            <span class="badge bg-secondary">Takım Çalışması</span>
                            <span class="badge bg-secondary">İletişim</span>
                            <span class="badge bg-secondary">Öğrenme İsteği</span>

                        </div>

                    </div>

                </div>


                <!-- Backend -->

                <div class="timeline-item">

                    <div class="timeline-dot"></div>

                    <div class="card timeline-card shadow border-primary">

                        <div class="card-header bg-primary text-white">
                            Backend Developer
                        </div>

                        <div class="card-body">

                            <span class="badge bg-warning text-dark mb-3">
                                AI'nin Önerdiği Sonraki Adım
                            </span>

                            <h6>Teknik Yetkinlikler</h6>

                            <span class="badge bg-primary">ASP.NET Core</span>
                            <span class="badge bg-primary">REST API</span>
                            <span class="badge bg-primary">Docker</span>
                            <span class="badge bg-primary">Redis</span>
                            <span class="badge bg-primary">Entity Framework</span>

                            <hr>

                            <h6>Soft Skills</h6>

                            <span class="badge bg-secondary">Analitik Düşünme</span>
                            <span class="badge bg-secondary">Problem Çözme</span>
                            <span class="badge bg-secondary">Zaman Yönetimi</span>

                        </div>

                    </div>

                </div>


                <!-- Senior -->

                <div class="timeline-item">

                    <div class="timeline-dot bg-warning"></div>

                    <div class="card timeline-card shadow">

                        <div class="card-header bg-warning">
                            Senior Backend Developer
                        </div>

                        <div class="card-body">

                            <h6>Teknik Yetkinlikler</h6>

                            <span class="badge bg-primary">Microservices</span>
                            <span class="badge bg-primary">Kafka</span>
                            <span class="badge bg-primary">Kubernetes</span>
                            <span class="badge bg-primary">Azure</span>

                            <hr>

                            <h6>Soft Skills</h6>

                            <span class="badge bg-secondary">Mentorluk</span>
                            <span class="badge bg-secondary">Liderlik</span>
                            <span class="badge bg-secondary">Karar Verme</span>

                        </div>

                    </div>

                </div>


                <!-- Architect -->

                <div class="timeline-item">

                    <div class="timeline-dot bg-dark"></div>

                    <div class="card timeline-card shadow border-dark">

                        <div class="card-header bg-dark text-white">
                            Software Architect
                        </div>

                        <div class="card-body">

                            <h6>Teknik Yetkinlikler</h6>

                            <span class="badge bg-primary">Cloud Architecture</span>
                            <span class="badge bg-primary">System Design</span>
                            <span class="badge bg-primary">CI/CD</span>
                            <span class="badge bg-primary">DevOps</span>

                            <hr>

                            <h6>Soft Skills</h6>

                            <span class="badge bg-secondary">Stratejik Düşünme</span>
                            <span class="badge bg-secondary">Koçluk</span>
                            <span class="badge bg-secondary">İletişim</span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Data Engineer ve Cloud Engineer sekmelerine de aynı timeline yapısı eklenebilir -->

    </div>

</div>